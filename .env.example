# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# Get this from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# The exact domain(s) allowed to call this API (your live site).
# Comma-separated if you have more than one (e.g. with and without www).
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Port the server listens on (most hosts set this automatically — leave as-is)
PORT=3001

# --- Email verification (optional, needed for real signup codes) ---
# Example using Resend (resend.com) — swap for SendGrid/SES if you prefer.
RESEND_API_KEY=
EMAIL_FROM=Kanaf <noreply@yourdomain.com>

# --- Database (required for the admin panel + real persistence) ---
# postgresql://user:password@host:5432/marsa
DATABASE_URL=postgresql://marsa:changeme@localhost:5432/marsa

# --- Admin panel auth ---
# Generate a real random secret: openssl rand -hex 32
# Never reuse this value across environments (dev/staging/prod).
ADMIN_JWT_SECRET=change-this-to-a-long-random-string
# Access tokens expire quickly; the admin UI silently refreshes them.
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=7d

# --- Payment gateway (Moyasar) ---
# Get keys from https://dashboard.moyasar.com → Developers → API Keys.
# Use the TEST key while integrating (sk_test_...), switch to the LIVE
# key (sk_live_...) only after real end-to-end testing.
PAYMENT_PROVIDER=moyasar
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
# Any random string YOU generate — this is what you pass as
# shared_secret when running payments/register_webhook.js, and what
# isGenuineWebhook() compares against the secret_token Moyasar embeds
# in every webhook body. Generate: openssl rand -hex 24
PAYMENT_WEBHOOK_SECRET=

# Where your consumer app is served — used to build the success/cancel
# redirect URLs after checkout.
APP_BASE_URL=https://yourdomain.com
# Where marsa-server itself is reachable — used to build the webhook
# callback URL. Must be HTTPS in live mode.
SERVER_BASE_URL=https://yourdomain.com
