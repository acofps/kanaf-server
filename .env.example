# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية. لا تُرفع ".env" إلى git أبداً.

# ============================================================
# Anthropic
# ============================================================
# من https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# الشبكة والنطاقات
# ============================================================
# النطاقات المسموح لها بمناداة هذه الواجهة، مفصولة بفواصل.
# ⚠️ لا تتركها فارغة في الإنتاج: الكود عندها يعكس أي مصدر مع
# credentials: true، وهو أسوأ من غياب CORS.
# KANAF-ORD-0010 §5.1: أثناء نقل النطاق تحمل القيمة على Render القديم والجديد معاً
#   (https://kanaf.me,https://app.kanaf.me,https://tanfs.net,https://app.tanfs.net,https://kanaf-server.onrender.com)
#   ويُحذف القديمان أخيراً بعد التأكد أن لا شيء ينادي منهما. هذه هي القيمة النهائية:
ALLOWED_ORIGINS=https://tanfs.net,https://app.tanfs.net,https://kanaf-server.onrender.com

# المنفذ (معظم المستضيفات تضبطه تلقائياً — اتركه كما هو)
PORT=3001

# يجب أن تكون production على الإنتاج. ليست شكلية: بدونها يصير غياب
# إعداد SMTP مجرد سطر في السجل بدل خطأ صريح — أي يرد {ok:true}
# والمستخدم لا يصله كود.
NODE_ENV=production

# ============================================================
# البريد — SMTP (وليس Resend)
# ============================================================
# ⚠️ كان هذا الملف يوثّق RESEND_API_KEY الذي لا يستخدمه الكود
# إطلاقاً. المُرسل الفعلي هو mail/send.js عبر SMTP.
SMTP_HOST=mail.tanfs.net
SMTP_PORT=465
SMTP_USER=noreply@tanfs.net
SMTP_PASS=
EMAIL_FROM=تنفس <noreply@tanfs.net>

# ============================================================
# إشعارات الجهاز (Web Push / VAPID) — notifications/push.js
# ============================================================
# المفتاحان (مرة واحدة): node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# صاحب الخدمة الذي يتصل به مزوّد الإشعارات (RFC 8292): mailto: نظيف أو https://.
# ⚠️ لا اسم عرض ولا مسافات ولا أقواس. KANAF-ORD-0010 §2: كان يُشتق من EMAIL_FROM
#    فيخرج «mailto:تنفس <noreply@…>»، عنواناً غير صالح يُوقَّع به كل إشعار.
#    بدونه أو بقيمة غير صالحة لا تُرسل إشعارات الجهاز إطلاقاً، ويُطبع السبب في السجل.
#    والصندوق support@tanfs.net يجب أن يوجد ويُقرأ: إليه يكتب مزوّد الإشعارات عند المشكلات.
VAPID_SUBJECT=mailto:support@tanfs.net

# ============================================================
# قاعدة البيانات
# ============================================================
# 🔴 مصيدة sslmode — KANAF-ORD-0012 §1.3 (وقعت فعلاً في 2026-11-19):
#   لا تضع ?sslmode=… في DATABASE_URL أبداً. التشفير يُقرَّر من DB_SSL وحده.
#   السبب: pg@8 إذا وجد sslmode في السلسلة **يرمي** إعداد ssl الممرَّر من db/pool.js
#   ({rejectUnauthorized:false}) ويستبدله بتحقق كامل من الشهادة. وشهادة خادم الاستضافة
#   موقَّعة ذاتياً، فيفشل الاتصال بـ «self-signed certificate in certificate chain» — خطأ
#   يُقرأ كأنه كلمة مرور خاطئة، فيُبحث في الاتجاه المعاكس.
#   مقيس على pg 8.22.0:  ?sslmode=require → ssl={}  ·  بلا sslmode → ssl={rejectUnauthorized:false}
#   والخادم يطبع تحذيراً عند الإقلاع إن وجد sslmode في السلسلة (db/pool.js).
# الإنتاج اليوم: المضيف tanfs.net، المستخدم والقاعدة kanaf_kanaf، المنفذ 5432، بلا sslmode.
#   (والأفضل لاحقاً عنوان IP أو مضيف لا يتبع DNS الموقع — ORD-0012 §1.12.)
DATABASE_URL=postgresql://user:password@host:5432/dbname
# true = اتصال مشفَّر بلا تحقق من الشهادة (الشهادة موقَّعة ذاتياً). الإنتاج اليوم: true.
# false = بلا تشفير. ولا تجعل التشفير من sslmode في DATABASE_URL — انظر أعلاه وdb/pool.js.
DB_SSL=false

# ============================================================
# مصادقة لوحة الإدارة ومصادقة المستخدمين
# ============================================================
# ولّد كل واحد على حدة: openssl rand -hex 32
# ⚠️ يجب أن يختلفا. لو تطابقا صار رمز أي مستخدم عادي رمز إدارة
# صالحاً — والخادم يرفض الإقلاع في هذه الحالة.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=7d
USER_JWT_SECRET=
# حد طلبات مسارات المصادقة لكل IP كل 15 دقيقة (الافتراضي 20)
AUTH_RATE_LIMIT_MAX=20

# ============================================================
# بوابة الدفع — Moyasar
# ============================================================
# المفاتيح من https://dashboard.moyasar.com ← Developers ← API Keys
# ابدأ بمفتاح الاختبار sk_test_ ولا تنتقل لـsk_live_ إلا بعد اختبار
# دورة كاملة فعلية.
PAYMENT_PROVIDER=moyasar
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# سر تشاركي تولّده أنت: openssl rand -hex 24
# هو ما تمرره عند تشغيل payments/register_webhook.js، وهو ما يقارنه
# isGenuineWebhook بحقل secret_token المضمَّن في كل حمولة.
# ⚠️ Moyasar لا تستخدم توقيع HMAC — تحقق مبني على افتراض HMAC كان
# سيقبل حمولات مزوّرة بلا أن يلاحظ أحد.
PAYMENT_WEBHOOK_SECRET=

# بعد ضبط ما سبق، سجّل الـwebhook مرة واحدة لكل بيئة:
#   node payments/register_webhook.js https://kanaf-server.onrender.com/api/payments/webhook
# ويسجّل الأحداث الأربعة التي يعالجها الخادم فعلاً:
#   payment_paid, payment_failed, payment_refunded, payment_voided

# ============================================================
# العناوين
# ============================================================
# تطبيق المستخدم — تُبنى منه روابط النجاح والإلغاء بعد الدفع
APP_BASE_URL=https://app.tanfs.net
# هذا الخادم — يُبنى منه عنوان الـcallback للـwebhook. HTTPS إلزامي
# في وضع الإنتاج.
SERVER_BASE_URL=https://kanaf-server.onrender.com

# ============================================================
# إعداد لمرة واحدة وإلغاء الاشتراك من الرسائل
# ============================================================
# يفتح /api/setup/create-first-admin و/api/setup/run-migrations.
# تركه فارغاً يعطّل المسارين تماماً.
SETUP_TOKEN=

# KANAF-ORD-0008 §7 — مفتاح تشفير اعتمادات التكاملات (AES-256-GCM)، 32 بايتاً:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# بدونه تُعطَّل صفحة التكاملات للحفظ (لا تخزين بنص صريح بحال).
# فقدانه = فقدان كل الاعتمادات المحفوظة. لا يُخزَّن في المستودع.
INTEGRATIONS_ENC_KEY=
# لتوقيع روابط إلغاء الاشتراك من الرسائل التسويقية
UNSUBSCRIBE_SECRET=

# ============================================================
# متغيّرات أكتوبر (ORD-0001…0004) — لم تكن موثّقة هنا (جرد KANAF-ORD-0012 §2.4)
# كلها اختيارية: الفارغ = القيمة الافتراضية المكتوبة، مقروءة من الكود نفسه.
# ============================================================
# مسار المسح المجدول POST /api/internal/sweep (ops/internal.js). فارغ أو أقصر من 24 محرفاً
# = المسار يرد 404، ويبقى التذكير اليومي والحملات المجدولة رهن حركة الطلبات (تُمسح عند
# أول طلب بعد المهلة). لجدولة حقيقية: قيمة عشوائية ≥24 محرفاً + خدمة Cron ترسلها في X-Sweep-Token.
SWEEP_TRIGGER_TOKEN=
# عدد الوكلاء أمام الخادم لقراءة IP العميل (Render = 1). خطأ هذه القيمة يُفسد حدود المعدّل.
TRUST_PROXY_HOPS=1
# تحقق الدفع من المزوّد مباشرةً (N-02/COR): "1" يفعّله، وأي قيمة أخرى تعطّله (الافتراضي معطّل).
KANAF_PAYMENT_PROVIDER_VERIFY=
KANAF_PAYMENT_PROVIDER_TIMEOUT_MS=10000
# محاولات دخول اللوحة قبل التبريد (013)
ADMIN_LOGIN_FREE_ATTEMPTS=5
# أدنى فاصل بين مسحين يطلقهما الطلب (مللي ثانية)
SWEEP_MIN_INTERVAL_MS=60000
REMINDER_SWEEP_MIN_INTERVAL_MS=300000
# مهلة الإرسال المتزامن للحملة من اللوحة قبل تحويلها للخلفية
CAMPAIGN_SYNC_BUDGET_MS=8000
# تنظيف رموز التحقق والجلسات المنتهية عبر المسار الداخلي: عدد الأيام (فارغ = لا تنظيف)
AUTH_CLEANUP_RETENTION_DAYS=
# مدة رمز الوصول ومدة التجديد للمستخدم
USER_JWT_EXPIRES_IN=15m
USER_REFRESH_EXPIRES_DAYS=30
# مولّد الفواتير: SKIP_PDF_BOOT_CHECK=1 يتخطى فحص الإقلاع (للاختبار فقط، لا للإنتاج).
# PDF_HEADLESS_MODE / PDF_BROWSER_IDLE_MS / PDF_BROWSER_MAX_RENDERS / PDF_RENDER_TIMEOUT_MS /
# PDF_DOC_CONCURRENCY / PDF_DOC_MAX_WAITING: ضبط دقيق، الافتراضي في invoicing/render.js.

# ============================================================
# ملاحظة: الضريبة والعملة والمنطقة الزمنية المحاسبية ليست هنا
# ============================================================
# بعد المرحلة 3 صارت في جدول billing_settings، وتُدار من
# صفحة «الإعدادات المالية» في اللوحة (owner فقط).
# سببها: النسبة تدخل في وثيقة قانونية، وتغييرها يجب أن يُسجَّل باسم
# من غيّره ومتى — لا أن يمر كإعادة نشر صامتة لمتغيّر بيئة.
