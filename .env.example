# انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية. لا تُرفع ".env" إلى git أبداً.

# ============================================================
# Anthropic
# ============================================================
# من https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# ============================================================
# الشبكة والنطاقات
# ============================================================
# النطاقات المسموح لها بمناداة هذه الواجهة، مفصولة بفواصل.
# ⚠️ لا تتركها فارغة في الإنتاج: الكود عندها يعكس أي مصدر مع
# credentials: true، وهو أسوأ من غياب CORS.
ALLOWED_ORIGINS=https://kanaf.me,https://app.kanaf.me,https://kanaf-server.onrender.com

# المنفذ (معظم المستضيفات تضبطه تلقائياً — اتركه كما هو)
PORT=3001

# يجب أن تكون production على الإنتاج. ليست شكلية: بدونها يصير غياب
# إعداد SMTP مجرد سطر في السجل بدل خطأ صريح — أي يرد {ok:true}
# والمستخدم لا يصله كود.
NODE_ENV=production

# ============================================================
# البريد — SMTP (وليس Resend)
# ============================================================
# ⚠️ كان هذا الملف يوثّق RESEND_API_KEY الذي لا يستخدمه الكود
# إطلاقاً. المُرسل الفعلي هو mail/send.js عبر SMTP.
SMTP_HOST=mail.kanaf.me
SMTP_PORT=465
SMTP_USER=noreply@kanaf.me
SMTP_PASS=
EMAIL_FROM=كنف <noreply@kanaf.me>

# ============================================================
# قاعدة البيانات
# ============================================================
DATABASE_URL=postgresql://user:password@host:5432/dbname
# فعّلها true فقط بعد أن يدعم الخادم SSL فعلاً ويكون pg_hba.conf
# متوافقاً معه — انظر التعليق في db/pool.js.
DB_SSL=false

# ============================================================
# مصادقة لوحة الإدارة ومصادقة المستخدمين
# ============================================================
# ولّد كل واحد على حدة: openssl rand -hex 32
# ⚠️ يجب أن يختلفا. لو تطابقا صار رمز أي مستخدم عادي رمز إدارة
# صالحاً — والخادم يرفض الإقلاع في هذه الحالة.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRES_IN=15m
ADMIN_REFRESH_EXPIRES_IN=7d
USER_JWT_SECRET=
# حد طلبات مسارات المصادقة لكل IP كل 15 دقيقة (الافتراضي 20)
AUTH_RATE_LIMIT_MAX=20

# ============================================================
# بوابة الدفع — Moyasar
# ============================================================
# المفاتيح من https://dashboard.moyasar.com ← Developers ← API Keys
# ابدأ بمفتاح الاختبار sk_test_ ولا تنتقل لـsk_live_ إلا بعد اختبار
# دورة كاملة فعلية.
PAYMENT_PROVIDER=moyasar
PAYMENT_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# سر تشاركي تولّده أنت: openssl rand -hex 24
# هو ما تمرره عند تشغيل payments/register_webhook.js، وهو ما يقارنه
# isGenuineWebhook بحقل secret_token المضمَّن في كل حمولة.
# ⚠️ Moyasar لا تستخدم توقيع HMAC — تحقق مبني على افتراض HMAC كان
# سيقبل حمولات مزوّرة بلا أن يلاحظ أحد.
PAYMENT_WEBHOOK_SECRET=

# بعد ضبط ما سبق، سجّل الـwebhook مرة واحدة لكل بيئة:
#   node payments/register_webhook.js https://kanaf-server.onrender.com/api/payments/webhook
# ويسجّل الأحداث الأربعة التي يعالجها الخادم فعلاً:
#   payment_paid, payment_failed, payment_refunded, payment_voided

# ============================================================
# العناوين
# ============================================================
# تطبيق المستخدم — تُبنى منه روابط النجاح والإلغاء بعد الدفع
APP_BASE_URL=https://app.kanaf.me
# هذا الخادم — يُبنى منه عنوان الـcallback للـwebhook. HTTPS إلزامي
# في وضع الإنتاج.
SERVER_BASE_URL=https://kanaf-server.onrender.com

# ============================================================
# إعداد لمرة واحدة وإلغاء الاشتراك من الرسائل
# ============================================================
# يفتح /api/setup/create-first-admin و/api/setup/run-migrations.
# تركه فارغاً يعطّل المسارين تماماً.
SETUP_TOKEN=
# لتوقيع روابط إلغاء الاشتراك من الرسائل التسويقية
UNSUBSCRIBE_SECRET=

# ============================================================
# ملاحظة: الضريبة والعملة والمنطقة الزمنية المحاسبية ليست هنا
# ============================================================
# بعد المرحلة 3 صارت في جدول billing_settings، وتُدار من
# صفحة «الإعدادات المالية» في اللوحة (owner فقط).
# سببها: النسبة تدخل في وثيقة قانونية، وتغييرها يجب أن يُسجَّل باسم
# من غيّره ومتى — لا أن يمر كإعادة نشر صامتة لمتغيّر بيئة.
